<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QrCodeGenerator.Ui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="520"
        x:Class="QrCodeGenerator.Ui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/avalonia-logo.ico"
        Title="QR Code Generator"
        Width="720"
        Height="430">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Border Margin="24"
            Padding="24"
            CornerRadius="16"
            BorderThickness="1">

        <StackPanel Spacing="20">

            <StackPanel Spacing="4">
                <TextBlock Text="QR Code Generator"
                           FontSize="24"
                           FontWeight="SemiBold" />

                <TextBlock Text="Create a QR code from a website URL and choose your colours."
                           Opacity="0.65" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Website URL"
                           FontWeight="SemiBold" />

                <TextBox Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Watermark="https://website.com"
                         MinHeight="38" />

                <TextBlock Text="{Binding UrlError}"
                           TextWrapping="Wrap"
                           Foreground="Red"
                           FontSize="12" />
            </StackPanel>

            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto"
                  ColumnSpacing="16">

                <StackPanel Grid.Column="0" Spacing="8">
                    <TextBlock Text="QR code colour"
                               FontWeight="SemiBold" />

                    <ColorPicker Color="{Binding DarkColour, Mode=TwoWay}"
                                 IsAlphaEnabled="False" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="Background colour"
                               FontWeight="SemiBold" />

                    <ColorPicker Color="{Binding LightColour, Mode=TwoWay}"
                                 IsAlphaEnabled="False" />
                </StackPanel>

            </Grid>

            <Border BorderBrush="Orange"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    IsVisible="{Binding HasContrastWarning}">

                <DockPanel>
                    <TextBlock Text="⚠"
                               FontSize="22"
                               Margin="0,0,12,0"
                               DockPanel.Dock="Left" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="QR contrast warning"
                                   FontWeight="SemiBold" />

                        <TextBlock Text="{Binding ContrastWarning}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Button Content="Generate QR Code"
                    Command="{Binding GenerateCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    HorizontalAlignment="Right"
                    MinWidth="160" />

        </StackPanel>
    </Border>
</Window>